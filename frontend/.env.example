# Stellar network: testnet | futurenet | mainnet | local
VITE_STELLAR_NETWORK=testnet

# Soroban RPC (optional; defaults from deployments/v1/<network>.json)
# VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Horizon (optional)
# VITE_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Relayer gateway hub (optional; comma-separated list; wallet uses the first URL).
# Defaults to deployments/v1/<network>.json wiring, then http://127.0.0.1:8787.
# VITE_RELAYER_GATEWAY_URL=https://relay-testnet.opaque.cash

# Reputation publisher API for PSR on-chain proof flow.
# Required for Submit On-Chain because the wallet must publish/fetch the PSR Merkle path.
# VITE_REPUTATION_PUBLISHER_URL=http://127.0.0.1:8790

# Canonical contract IDs live in deployments/v1/<network>.json.
# Override only for local development (non-production builds):
# VITE_TESTNET_STEALTH_REGISTRY_CONTRACT=
# VITE_TESTNET_STEALTH_ANNOUNCER_CONTRACT=
# VITE_TESTNET_GROTH16_VERIFIER_CONTRACT=
# VITE_TESTNET_REPUTATION_VERIFIER_CONTRACT=
# VITE_TESTNET_SCHEMA_REGISTRY_CONTRACT=
# VITE_TESTNET_ATTESTATION_ENGINE_CONTRACT=

# Mainnet overrides (required until deployments/v1/mainnet.json is populated):
# VITE_MAINNET_STEALTH_REGISTRY_CONTRACT=
# ...

# Opt-in error reporting collector (#560). Reporting stays OFF until the user
# explicitly enables it in Settings; leaving this unset disables the feature
# entirely, so no build can send reports by accident.
# VITE_ERROR_REPORT_ENDPOINT=https://errors.opaque.cash/v1/reports

# Build identifier attached to error reports. Defaults to "dev".
# VITE_APP_VERSION=0.0.0
