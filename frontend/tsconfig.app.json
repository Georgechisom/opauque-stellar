{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "baseUrl": ".",
    "paths": {
      "@wasm/*": ["public/pkg/*"],
      "@deployments": ["../deployments/index.ts"],
      "@deployments/*": ["../deployments/*"],
      "@relayer/*": ["../relayer/src/*"],
      "@stellar/stellar-sdk": ["node_modules/@stellar/stellar-sdk"],
      "@noble/hashes/*": ["node_modules/@noble/hashes/*"],
      "tweetnacl": ["node_modules/tweetnacl"],
      "buffer": ["node_modules/buffer"]
    },
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src", "../deployments/**/*.ts", "../deployments/v1/*.json", "../artifacts/manifest.json", "../relayer/src/shared/**/*.ts", "../relayer/src/messages.ts", "public/pkg/**/*.d.ts"]
}
