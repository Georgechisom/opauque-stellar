{
  "name": "@opaquecash/stellar",
  "version": "0.0.0",
  "description": "Stealth private payments, privacy pools, relayer-market submission, and on-chain ZK reputation for Stellar/Soroban.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./crypto": {
      "types": "./dist/crypto/index.d.ts",
      "import": "./dist/crypto/index.js",
      "require": "./dist/crypto/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/e2e"
  },
  "peerDependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@stellar/stellar-sdk": "^15.1.0",
    "circomlibjs": "^0.1.7",
    "snarkjs": "^0.7.6",
    "tweetnacl": "^1.0.3"
  },
  "peerDependenciesMeta": {
    "snarkjs": {
      "optional": true
    },
    "circomlibjs": {
      "optional": true
    },
    "tweetnacl": {
      "optional": true
    }
  },
  "devDependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@stellar/stellar-sdk": "^15.1.0",
    "@types/node": "^22.15.0",
    "circomlibjs": "^0.1.7",
    "snarkjs": "^0.7.6",
    "tsup": "^8.3.5",
    "typescript": "^5.8.3",
    "vitest": "^4.1.7"
  }
}
